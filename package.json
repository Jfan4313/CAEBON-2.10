{
  "name": "zero-carbon-decision-support",
  "private": true,
  "version": "2.14.0",
  "description": "园区综合能源项目投资收益测算与辅助决策系统",
  "author": "待权利人确认",
  "productName": "园区综合能源项目投资收益测算与辅助决策系统",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.zerocarbon.valuation",
    "productName": "园区综合能源项目投资收益测算与辅助决策系统",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      {
        "from": "electron",
        "to": "electron",
        "filter": ["**/*"]
      },
      {
        "from": "dist",
        "to": "dist",
        "filter": ["**/*"]
      },
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "@types/react": "^19.2.14",
    "axios": "^1.13.5",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "pigeon-maps": "^0.22.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
